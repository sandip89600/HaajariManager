<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F97316" />
      <stop offset="100%" stop-color="#EA580C" />
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#000000" flood-opacity="0.25"/>
    </filter>
  </defs>
  <!-- Background Card -->
  <rect width="512" height="512" rx="128" fill="url(#bgGrad)" />
  <!-- Logo Emblem 'H' -->
  <g filter="url(#shadow)">
    <!-- Left Pillar -->
    <rect x="128" y="112" width="68" height="288" rx="24" fill="#FFFFFF" />
    <!-- Right Pillar -->
    <rect x="316" y="112" width="68" height="288" rx="24" fill="#FFFFFF" />
    <!-- Cross Bridge -->
    <rect x="128" y="224" width="256" height="64" rx="20" fill="#FFFFFF" />
    <!-- Checkmark Accent -->
    <path d="M 336 312 L 368 344 L 424 272" fill="none" stroke="#10B981" stroke-width="28" stroke-linecap="round" stroke-linejoin="round" />
  </g>
</svg>
